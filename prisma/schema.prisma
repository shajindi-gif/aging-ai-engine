generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// AUTH MODELS (NextAuth.js)
// ═══════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ═══════════════════════════════════════════
// CORE USER & ORG
// ═══════════════════════════════════════════

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  phone           String?   @unique
  passwordHash    String?
  image           String?
  role            UserRole  @default(FAMILY)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  elderlyProfiles ElderlyProfile[]
  cases           Case[]
  orders          Order[]
  entitlements    Entitlement[]
  auditEvents     AuditEvent[]
  agentRuns       AgentRun[]

  @@index([organizationId])
  @@index([role])
}

enum UserRole {
  ADMIN
  OPERATOR
  CAREGIVER
  FAMILY
  VIEWER
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  address     String?
  city        String?
  province    String?
  contactName String?
  contactPhone String?
  licenseNo   String?
  users       User[]
  elderlyProfiles ElderlyProfile[]
  careOrders  CareOrder[]
  carePlans   CarePlan[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type])
  @@index([province, city])
}

enum OrganizationType {
  NURSING_HOME
  COMMUNITY_STATION
  CARE_COMPANY
  HOSPITAL
  GOVERNMENT
  ENTERPRISE
}

// ═══════════════════════════════════════════
// ELDERLY CARE DOMAIN
// ═══════════════════════════════════════════

model ElderlyProfile {
  id              String              @id @default(cuid())
  name            String
  gender          Gender              @default(MALE)
  birthDate       DateTime
  idCard          String?
  phone           String?
  address         String?
  city            String?
  province        String?
  careLevel       CareLevel           @default(INDEPENDENT)
  serviceType     ElderlyServiceType  @default(HOME)
  livingStatus    String?
  incomeLevel     String?
  disabilityLevel String?
  tags            String[]
  organizationId  String?
  userId          String?
  organization    Organization?       @relation(fields: [organizationId], references: [id])
  user            User?               @relation(fields: [userId], references: [id])
  emergencyContact EmergencyContact?
  familyMembers   FamilyMember[]
  healthSummary   HealthSummary?
  medications     Medication[]
  visitRecords    VisitRecord[]
  riskFlags       RiskFlag[]
  careOrders      CareOrder[]
  medicationReminders MedicationReminder[]
  followUpReminders   FollowUpReminder[]
  assessments     Assessment[]
  carePlans       CarePlan[]
  cases           Case[]
  chronicMetrics  ChronicMetric[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([careLevel])
  @@index([province, city])
  @@index([name])
}

enum Gender {
  MALE
  FEMALE
}

enum CareLevel {
  INDEPENDENT
  SEMI_DEPENDENT
  DEPENDENT
  CRITICAL
}

enum ElderlyServiceType {
  HOME
  COMMUNITY
  INSTITUTION
}

model EmergencyContact {
  id            String         @id @default(cuid())
  name          String
  phone         String
  relationship  String
  elderlyId     String         @unique
  elderly       ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id            String         @id @default(cuid())
  name          String
  relationship  String
  phone         String?
  isPrimary     Boolean        @default(false)
  elderlyId     String
  elderly       ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  @@index([elderlyId])
}

model HealthSummary {
  id              String         @id @default(cuid())
  elderlyId       String         @unique
  chronicDiseases String[]
  allergies       String[]
  bloodType       String?
  disabilityLevel String?
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Medication {
  id               String         @id @default(cuid())
  name             String
  dosage           String
  frequency        String
  startDate        DateTime
  endDate          DateTime?
  prescribingDoctor String?
  elderlyId        String
  elderly          ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  @@index([elderlyId])
}

model VisitRecord {
  id          String         @id @default(cuid())
  date        DateTime
  hospital    String
  department  String?
  diagnosis   String?
  doctor      String?
  notes       String?
  elderlyId   String
  elderly     ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  @@index([elderlyId])
  @@index([date])
}

model RiskFlag {
  id          String         @id @default(cuid())
  type        RiskFlagType
  level       RiskLevel
  description String
  detectedAt  DateTime       @default(now())
  resolvedAt  DateTime?
  elderlyId   String
  elderly     ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  @@index([elderlyId])
  @@index([type, level])
  @@index([resolvedAt])
}

enum RiskFlagType {
  FALL
  MEDICATION
  VITAL
  BEHAVIOR
  NUTRITION
  OTHER
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ChronicMetric {
  id            String         @id @default(cuid())
  elderlyId     String
  metricDate    DateTime
  systolicBP    Int?
  diastolicBP   Int?
  bloodSugar    Float?
  heartRate     Int?
  weight        Float?
  temperature   Float?
  notes         String?
  elderly       ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  @@index([elderlyId])
  @@index([metricDate])
}

// ═══════════════════════════════════════════
// CARE ORDERS & SERVICE
// ═══════════════════════════════════════════

model CareOrder {
  id              String           @id @default(cuid())
  orderNo         String           @unique
  elderlyId       String
  elderlyName     String
  type            CareOrderType
  status          CareOrderStatus  @default(PENDING)
  scheduledAt     DateTime
  completedAt     DateTime?
  caregiverId     String?
  caregiverName   String?
  location        String?
  notes           String?
  familyNotified  Boolean          @default(false)
  price           Float            @default(0)
  paymentStatus   PaymentStatus    @default(UNPAID)
  organizationId  String?
  elderly         ElderlyProfile   @relation(fields: [elderlyId], references: [id])
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  riskEvents      RiskEvent[]
  serviceReport   ServiceReport?
  serviceTasks    ServiceTask[]
  serviceRecords  ServiceRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([elderlyId])
  @@index([organizationId])
  @@index([status])
  @@index([scheduledAt])
  @@index([orderNo])
}

enum CareOrderType {
  ESCORT
  NURSING
  REHABILITATION
  COMPANION
  BATHING
  MEAL
  CLEANING
  MEDICATION_REMINDER
  FOLLOWUP
  POST_SURGERY
}
enum CareOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model RiskEvent {
  id          String             @id @default(cuid())
  orderId     String
  type        String
  description String
  severity    RiskEventSeverity
  occurredAt  DateTime           @default(now())
  handledBy   String?
  handledAt   DateTime?
  resolution  String?
  order       CareOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@index([severity])
}

enum RiskEventSeverity {
  LOW
  MEDIUM
  HIGH
}

model ServiceReport {
  id                 String      @id @default(cuid())
  orderId            String      @unique
  summary            String
  healthObservations String[]
  recommendations    String[]
  photos             String[]
  submittedAt        DateTime    @default(now())
  submittedBy        String?
  order              CareOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ServiceTask {
  id            String           @id @default(cuid())
  careOrderId   String
  carePlanId    String?
  taskType      String
  description   String
  assignedTo    String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  status        ServiceTaskStatus @default(PENDING)
  result        String?
  notes         String?
  careOrder     CareOrder        @relation(fields: [careOrderId], references: [id])
  carePlan      CarePlan?        @relation(fields: [carePlanId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([careOrderId])
  @@index([carePlanId])
  @@index([status])
}

enum ServiceTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRecord {
  id            String      @id @default(cuid())
  careOrderId   String
  elderlyId     String?
  providerId    String?
  recordType    String
  content       String
  riskLevel     String?
  familyVisible Boolean     @default(true)
  careOrder     CareOrder   @relation(fields: [careOrderId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([careOrderId])
  @@index([elderlyId])
}

model CareProvider {
  id              String    @id @default(cuid())
  name            String
  type            String
  phone           String?
  certification   String?
  specialties     String[]
  rating          Float?
  available       Boolean   @default(true)
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MedicationReminder {
  id              String         @id @default(cuid())
  elderlyId       String
  medicationName  String
  dosage          String
  frequency       String
  reminderTime    String[]
  active          Boolean        @default(true)
  lastTakenAt     DateTime?
  missedCount     Int            @default(0)
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([elderlyId])
  @@index([active])
}

model FollowUpReminder {
  id            String         @id @default(cuid())
  elderlyId     String
  hospital      String
  department    String?
  doctor        String?
  scheduledDate DateTime
  reason        String?
  notified      Boolean        @default(false)
  completed     Boolean        @default(false)
  elderly       ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([elderlyId])
  @@index([scheduledDate])
  @@index([completed])
}

// ═══════════════════════════════════════════
// ASSESSMENT & CARE PLAN
// ═══════════════════════════════════════════

model Assessment {
  id              String         @id @default(cuid())
  elderlyId       String
  assessmentType  AssessmentType
  score           Float?
  findings        Json?
  recommendations String[]
  assessorId      String?
  status          AssessmentStatus @default(COMPLETED)
  assessedAt      DateTime       @default(now())
  nextDueDate     DateTime?
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id])
  carePlan        CarePlan?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([elderlyId])
  @@index([assessmentType])
  @@index([status])
}

enum AssessmentType {
  FUNCTIONAL
  COGNITIVE
  ADL
  MEDICAL
  COMPREHENSIVE
}
enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model CarePlan {
  id              String         @id @default(cuid())
  elderlyId       String
  assessmentId    String?        @unique
  organizationId  String?
  title           String
  goals           String[]
  interventions   Json?
  todayActions    String[]
  weekPlan        Json?
  monthPlan       Json?
  frequency       String?
  startDate       DateTime
  endDate         DateTime?
  status          CarePlanStatus @default(ACTIVE)
  createdBy       String?
  approvedBy      String?
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id])
  assessment      Assessment?    @relation(fields: [assessmentId], references: [id])
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  serviceTasks    ServiceTask[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([elderlyId])
  @@index([organizationId])
  @@index([status])
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

// ═══════════════════════════════════════════
// POLICY & RAG
// ═══════════════════════════════════════════

model Policy {
  id                String        @id @default(cuid())
  title             String
  category          PolicyCategory
  level             PolicyLevel
  province          String
  city              String?
  department        String?
  effectiveDate     DateTime?
  expiryDate        DateTime?
  status            PolicyStatus  @default(ACTIVE)
  summary           String
  fullText          String?
  eligibility       String[]
  benefits          String?
  requiredDocuments String[]
  applicationProcess String[]
  applicationUrl    String?
  contactPhone      String?
  tags              String[]
  sourceUrl         String?
  chunks            PolicyChunk[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([category])
  @@index([level])
  @@index([province, city])
  @@index([status])
  @@index([tags])
}

enum PolicyCategory {
  SUBSIDY
  INSURANCE
  SERVICE
  HOUSING
  MEDICAL
  EMPLOYMENT
  TAX
  LONG_TERM_CARE
  SMART_AGING
  TRAINING
  OTHER
}
enum PolicyLevel {
  NATIONAL
  PROVINCIAL
  MUNICIPAL
  DISTRICT
}
enum PolicyStatus {
  ACTIVE
  EXPIRED
  UPCOMING
}

model PolicyChunk {
  id          String   @id @default(cuid())
  policyId    String
  chunkIndex  Int
  content     String
  tokenCount  Int?
  metadata    Json?
  embedding   String?  // placeholder for vector(1536) — add via raw SQL when pgvector ready
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([policyId])
  @@index([chunkIndex])
}

// ═══════════════════════════════════════════
// INSTITUTIONS & SALES
// ═══════════════════════════════════════════

model Institution {
  id              String          @id @default(cuid())
  name            String
  type            InstitutionType
  province        String
  city            String
  district        String?
  address         String
  beds            Int             @default(0)
  occupancyRate   Float?
  priceMin        Float           @default(0)
  priceMax        Float           @default(0)
  priceUnit       PriceUnit       @default(MONTH)
  services        String[]
  rating          Float?
  contactName     String?
  contactPhone    String?
  website         String?
  licenseNo       String?
  establishedYear Int?
  tags            String[]
  digitalMaturity DigitalMaturity?
  salesLeads      SalesLead[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@index([province, city, district])
  @@index([rating])
}

enum InstitutionType {
  NURSING_HOME
  COMMUNITY_DAY_CARE
  HOME_CARE_AGENCY
  REHABILITATION_CENTER
  HOSPICE
  ASSISTED_LIVING
  ESCORT_COMPANY
  RENOVATION_VENDOR
  DAY_CARE_CENTER
}
enum PriceUnit {
  MONTH
  DAY
}
enum DigitalMaturityLevel {
  L1
  L2
  L3
  L4
  L5
}

model DigitalMaturity {
  id                   String               @id @default(cuid())
  institutionId        String               @unique
  score                Float
  level                DigitalMaturityLevel
  informationSystem    Float                @default(0)
  dataManagement       Float                @default(0)
  serviceDigitization  Float                @default(0)
  staffTechAdoption    Float                @default(0)
  familyEngagement     Float                @default(0)
  recommendations      String[]
  assessedAt           DateTime             @default(now())
  institution          Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model SalesLead {
  id              String            @id @default(cuid())
  institutionId   String
  institutionName String
  contactName     String?
  contactPhone    String?
  contactRole     String?
  source          SalesLeadSource
  status          SalesLeadStatus   @default(NEW)
  priority        SalesLeadPriority @default(MEDIUM)
  estimatedValue  Float?
  productInterest String[]
  score           Float?
  reason          String?
  notes           String?
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  assignedTo      String?
  institution     Institution       @relation(fields: [institutionId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([institutionId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([assignedTo])
  @@index([nextFollowUpAt])
}

enum SalesLeadSource {
  POLICY_SCAN
  WEB_CRAWL
  REFERRAL
  EXHIBITION
  COLD_CALL
}
enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}
enum SalesLeadPriority {
  HIGH
  MEDIUM
  LOW
}

// ═══════════════════════════════════════════
// UNIFIED CASE STATE
// ═══════════════════════════════════════════

model Case {
  id              String       @id @default(cuid())
  userId          String
  elderlyId       String?
  title           String?
  status          CaseStatus   @default(NEW)
  elderlyProfile  Json?
  assessment      Json?
  policyMatches   Json?
  evidence        Json?
  carePlan        Json?
  familyReport    Json?
  riskFlags       Json?
  paymentStatus   String?      @default("unpaid")
  approvalStatus  String?      @default("pending")
  user            User         @relation(fields: [userId], references: [id])
  elderly         ElderlyProfile? @relation(fields: [elderlyId], references: [id])
  agentRuns       AgentRun[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([elderlyId])
  @@index([status])
}

enum CaseStatus {
  NEW
  PROFILE_READY
  ASSESSMENT_COMPLETED
  POLICY_MATCHED
  PLAN_GENERATED
  PAYMENT_REQUIRED
  PAID
  TASK_CREATED
  SERVICE_COMPLETED
  REPORT_GENERATED
  PENDING_REVIEW
  APPROVED
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════
// AGENT RUNS & AUDIT
// ═══════════════════════════════════════════

model AgentRun {
  id              String          @id @default(cuid())
  caseId          String?
  userId          String?
  agentName       String
  skillName       String?
  toolName        String?
  model           String?
  promptVersion   String?
  skillVersion    String?
  inputHash       String?
  input           Json?
  output          Json?
  retrievedSources String[]
  confidence      Float?
  status          AgentRunStatus  @default(PENDING)
  latencyMs       Int?
  tokenUsage      Json?
  estimatedCost   Float?
  retryCount      Int             @default(0)
  fallbackUsed    Boolean         @default(false)
  humanReviewed   Boolean         @default(false)
  errorMessage    String?
  case            Case?           @relation(fields: [caseId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  startTime       DateTime        @default(now())
  endTime         DateTime?

  @@index([caseId])
  @@index([userId])
  @@index([agentName])
  @@index([status])
  @@index([startTime])
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

model AuditEvent {
  id            String    @id @default(cuid())
  userId        String?
  action        String
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// COMMERCIAL: ORDERS, PAYMENTS, ENTITLEMENTS
// ═══════════════════════════════════════════

model Order {
  id            String       @id @default(cuid())
  orderNo       String       @unique
  userId        String
  type          OrderType    @default(ONE_TIME)
  productName   String
  amount        Float
  currency      String       @default("CNY")
  status        OrderStatus  @default(PENDING)
  items         Json?
  user          User         @relation(fields: [userId], references: [id])
  payments      Payment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNo])
}

enum OrderType {
  SUBSCRIPTION
  ONE_TIME
}
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

model Payment {
  id                     String         @id @default(cuid())
  orderId                String
  provider               PaymentProvider
  providerTransactionId  String?        @unique
  amount                 Float
  currency               String         @default("CNY")
  status                 PaymentTxStatus @default(PENDING)
  paidAt                 DateTime?
  refundedAt             DateTime?
  metadata               Json?
  order                  Order          @relation(fields: [orderId], references: [id])
  createdAt              DateTime       @default(now())

  @@index([orderId])
  @@index([status])
  @@index([providerTransactionId])
}

enum PaymentProvider {
  ALIPAY
  WECHAT_PAY
  MOCK
}
enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Entitlement {
  id          String    @id @default(cuid())
  userId      String
  productId   String?
  orderId     String?
  featureKey  String
  status      EntitlementStatus @default(ACTIVE)
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([featureKey])
  @@index([status])
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planName          String
  planTier          String
  startDate         DateTime
  endDate           DateTime?
  currentPeriodEnd  DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  autoRenew         Boolean            @default(false)
  monthlyPrice      Float
  features          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ═══════════════════════════════════════════
// REPORTS
// ═══════════════════════════════════════════

model Report {
  id                String     @id @default(cuid())
  caseId            String?
  elderlyId         String?
  reportType        ReportType
  title             String
  content           String
  generatedByAgent  Boolean    @default(false)
  reviewedByHuman   Boolean    @default(false)
  agentRunId        String?
  pdfUrl            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([caseId])
  @@index([elderlyId])
  @@index([reportType])
}

enum ReportType {
  FAMILY_REPORT
  CARE_PLAN
  POLICY_MATCH
  ASSESSMENT
  SERVICE_SUMMARY
  RISK_ASSESSMENT
}

// ═══════════════════════════════════════════
// PRICING (database-backed, not hardcoded)
// ═══════════════════════════════════════════

model PricingPlan {
  id          String    @id @default(cuid())
  name        String
  tier        String    @unique
  price       Float
  currency    String    @default("CNY")
  period      String?   // "month", "year", null for one-time
  features    Json?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
