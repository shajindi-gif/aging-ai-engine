# ── 数据库 ──
# 生产/预览使用 Neon PostgreSQL；本地开发可指向任意 Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/aging_ai"

# ── 认证（NextAuth v5）──
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"
# 非 Vercel 环境（本地 next start / 自建部署）必须为 true，否则登录报 UntrustedHost
AUTH_TRUST_HOST="true"

# ── 站点 ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="衍策银龄 AI"

# ── LLM Provider Adapter（OpenAI 兼容，可选）──
# 未配置时 SilverCare AI Care Agent 自动降级为规则引擎模式（可正常运行）
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# ── 支付宝支付（服务端密钥，绝不进前端）──
# 支付模式: mock(默认,本地/测试) | alipay(真实商户)
PAY_MODE="mock"
ALIPAY_APP_ID=""
# 应用私钥 PKCS8 一行（\n 转义），从支付宝开放平台获取
ALIPAY_PRIVATE_KEY=""
# 支付宝公钥（验签用，注意不是应用公钥）
ALIPAY_PUBLIC_KEY=""
# 沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# 对外可达的站点根（回调地址用，如 https://yanglaoai999.com）
ALIPAY_NOTIFY_URL_BASE="https://yanglaoai999.com"

# ── 微信支付 APIv3（服务端密钥，绝不进前端）──
WXPAY_MCH_ID=""
WXPAY_APP_ID=""
WXPAY_SERIAL_NO=""
WXPAY_PRIVATE_KEY=""
WXPAY_APIV3_KEY=""
WXPAY_PUBKEY_ID=""
WXPAY_PUBKEY=""
WXPAY_NOTIFY_URL="https://yanglaoai999.com/api/pay/notify/wechat"

# ── 认证系统升级（邮箱/短信验证码）──
AUTH_CODE_SECRET=""            # 必填：标识HMAC与IP哈希盐（随机长字符串）
AUTH_CODE_TTL_SEC=300          # 验证码有效期（秒）
AUTH_CODE_COOLDOWN_SEC=60      # 重发冷却
AUTH_CODE_MAX_ATTEMPTS=5       # 尝试上限
RL_LOGIN_IP=10                 # 以下均为限流阈值（窗口内次数）
RL_CODE_IP=10
RL_CODE_ID=5
RL_CODE_GLOBAL=600
RL_REGISTER_IP=5
RL_RESET_IP=5
# 邮件（Resend 兼容 API；不配置时开发环境落 .outbox/ 文件）
RESEND_API_KEY=""
RESEND_FROM="衍策银龄 <noreply@yanglaoai999.com>"
# 短信供应商 Adapter：aliyun | tencent | mock（mock 仅限非生产）
SMS_PROVIDER="mock"
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
# 测试专用：显式开启后允许生产模式使用 outbox mock 渠道（勿在生产使用）
# AUTH_DEV_OUTBOX=1
